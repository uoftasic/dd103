# Experiment 3a — the long way round.
#
#   yosys scripts/explicit.ys
#
# "synth" is a macro. Here are the steps it runs, written out by hand, so you
# can see there is no magic in it -- and so you can add, remove or reorder one.

read_verilog -sv src/blinker.sv
hierarchy -check -top blinker
proc
opt
fsm
opt
memory
opt
techmap
opt
dfflibmap -liberty /foss/pdks/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty /foss/pdks/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
opt_clean
tee -o results/blinker_explicit.json stat -json -liberty /foss/pdks/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
stat -liberty /foss/pdks/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
